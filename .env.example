# HTBF local environment (copy to .env.local — never commit real secrets)

# Supabase (required for Prayer tests against a dev project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Account deletion permanent execution (server-only — never NEXT_PUBLIC_*)
# When HTBF_ACCOUNT_DELETION_EXECUTION_ENABLED=true, this comma-separated list is
# REQUIRED (fail-closed). Only listed account_deletion_requests.id values may
# invoke POST /api/admin/account-deletion/[requestId]/execute. Unset, empty, or
# malformed values block all execution. Initial Production rollout should list
# only the intentionally targeted disposable E2E request UUID — never commit
# real Production request IDs to the repository.
# HTBF_ACCOUNT_DELETION_EXECUTION_ENABLED=false
# HTBF_ACCOUNT_DELETION_EXECUTION_ALLOWED_REQUEST_IDS=
# HTBF_ACCOUNT_DELETION_STORAGE_EXECUTION_ENABLED=false
# HTBF_ACCOUNT_DELETION_PROFILE_EXECUTION_ENABLED=false
# HTBF_ACCOUNT_DELETION_AUTH_EXECUTION_ENABLED=false

# Playwright Prayer harness (development accounts only — placeholder values)
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3492
PLAYWRIGHT_OWNER_EMAIL=owner-dev@example.com
PLAYWRIGHT_OWNER_PASSWORD=replace-with-dev-password
PLAYWRIGHT_RESPONDER_EMAIL=responder-dev@example.com
PLAYWRIGHT_RESPONDER_PASSWORD=replace-with-dev-password
PLAYWRIGHT_THIRD_USER_EMAIL=third-dev@example.com
PLAYWRIGHT_THIRD_USER_PASSWORD=replace-with-dev-password

# Optional: admin account for automated moderation-guard tests
PLAYWRIGHT_ADMIN_EMAIL=admin-dev@example.com
PLAYWRIGHT_ADMIN_PASSWORD=replace-with-dev-password
